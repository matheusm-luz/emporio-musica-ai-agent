# Copy to .env and adjust. Every variable is optional except the API key when using OpenAI.

# --- LLM -------------------------------------------------------------------
# Format: "<provider>:<model>". Supported providers: ollama (local, free) | openai (cloud).
# Local development (requires Ollama running: https://ollama.com):
LLM_MODEL=ollama:gemma4:12b
# Production-like (requires OPENAI_API_KEY):
# LLM_MODEL=openai:gpt-6-luna

OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Conversation persistence ----------------------------------------------
# Postgres started by `docker compose up -d`. Leave empty to keep history in memory only.
DATABASE_URL=postgresql://emporio:emporio@localhost:5433/emporio

# --- Optional ----------------------------------------------------------------
# Freeze the agent clock (ISO 8601, America/Campo_Grande). Used by evals and example generation.
# AGENT_NOW=2026-11-25T10:00:00
# LangSmith tracing (no code changes needed):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
